{
  "expo": {
    "name": "BTP",
    "slug": "btp-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "btp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.btp.mobile"
    },
    "android": {
      "package": "com.btp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3ED"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
