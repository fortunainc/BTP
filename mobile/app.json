{
  "expo": {
    "name": "BTP",
    "slug": "btp-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "btp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/brand/app-icon.png",
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#3A1A1E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.btp.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.btp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon.png",
        "backgroundColor": "#3A1A1E"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
