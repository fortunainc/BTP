{
  "expo": {
    "name": "BTP",
    "slug": "btp-mobile",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "btp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/brand/app-icon.png",
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#070405"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.btp.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.btp.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/app-icon.png",
        "backgroundColor": "#070405"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82a0cee3-6918-404d-9d0d-65469e0e0e38"
      }
    },
    "owner": "plusoneapptest"
  }
}
