{
  "expo": {
    "name": "BTP",
    "slug": "btp-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "btp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.btp.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.btp.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3ED"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
