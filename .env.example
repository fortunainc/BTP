# Copy to .env.local for local development. Never commit real values.

# Database (PostgreSQL). Use a separate development database, never production.
DATABASE_URL=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=

# Privacy and anonymity salts (random strings; different per environment)
PROXY_SALT=
CROSS_REALM_SALT=
CAPABILITY_SALT=
ADMIN_AUDIT_HASH_SALT=

# Investor room (server-only). Key is base64 32 bytes; password stored as a scrypt hash.
BTP_INVESTOR_KEY=
BTP_INVESTOR_PASSWORD_HASH=

# Optional services
RESEND_API_KEY=
RESEND_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
OPENAI_API_KEY=
CRON_SECRET=

# Preview deployments block API access unless this is true AND a separate preview database is configured.
BTP_PREVIEW_DATABASE_ISOLATED=false

# Local-only helper; ignored in production.
ENABLE_LOCAL_TEST_LOGIN=false
